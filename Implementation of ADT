//Low Level

#include<stdio.h>
void main()
{
    int size,i;
    printf("Enter the size:");
    scanf("%d",&size);
    int arr[size];
    for(i=0;i<size;i++)
    {
        printf("Enter an element %d:",i+1);
        scanf("%d",&arr[i]);
    }
     printf("\nElements in the array\n");
      for(i=0;i<size;i++)
    {
        printf("\nValue of the element %d:",i+1);
        printf("%d",arr[i]);
    }
}

